PAPERCLIP_AGENT_JWT_SECRET={{ lookup('ansible.builtin.password', private_dir + '/paperclip-agent-jwt.secret', length=64, chars=['ascii_letters', 'digits']) }}
PAPERCLIP_HOME={{ paperclip_home }}
PAPERCLIP_INSTANCE_ID=default
PAPERCLIP_CONFIG={{ paperclip_home }}/instances/default/config.json
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_AUTH_DISABLE_SIGN_UP={{ 'true' if (paperclip_signup_closed | default(owner_bootstrap_check.stat.exists)) else 'false' }}
PAPERCLIP_BIND=loopback
PORT={{ paperclip_port }}
PAPERCLIP_ALLOWED_HOSTNAMES={{ paperclip_allowed_hosts | join(',') }}
PAPERCLIP_UI_DEV_MIDDLEWARE=false
PAPERCLIP_MIGRATION_PROMPT=never
PAPERCLIP_MIGRATION_AUTO_APPLY=true
