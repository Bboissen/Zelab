[Unit]
Description=Zelab native Hermes guest
After=network.target
ConditionPathExists={{ vm_disk }}
ConditionPathExists=/dev/kvm

[Service]
User={{ vm_user }}
Group={{ vm_user }}
SupplementaryGroups=kvm
RootDirectory={{ vm_root }}
MountAPIVFS=yes
BindReadOnlyPaths=/usr /lib /lib64 /etc/resolv.conf /etc/nsswitch.conf /usr/local/lib/zelab/qmp-poweroff.py:/qmp-poweroff.py
BindPaths={{ vm_data }}:/data /dev/kvm
PrivateDevices=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/data
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ExecStart=/usr/bin/qemu-system-x86_64 -enable-kvm -machine q35 -cpu host -smp {{ vm_cpu }} -m {{ vm_memory_mb }} -display none -monitor none -serial file:/data/console.log -qmp unix:/data/qmp.sock,server=on,wait=off -drive file=/data/disk.qcow2,format=qcow2,if=virtio,discard=unmap,detect-zeroes=unmap -drive file=/data/cloud-init.iso,format=raw,media=cdrom,readonly=on -nic user,model=virtio-net-pci,mac=52:54:00:12:34:56,ipv6=off{% if vm_isolated %},restrict=on{% endif %},hostfwd=tcp:127.0.0.1:{{ guest_ssh_port }}-:22,hostfwd=tcp:127.0.0.1:{{ guest_dashboard_port }}-:8640,hostfwd=tcp:127.0.0.1:{{ guest_api_port | default(18642) }}-:8642
ExecStop=/usr/bin/python3 /qmp-poweroff.py /data/qmp.sock
CPUQuota={{ vm_cpu_quota }}
MemoryMax={{ vm_memory_max }}
MemorySwapMax=0
TasksMax=128
KillMode=control-group
TimeoutStopSec=120
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
