[Unit]
Description=Zelab vault via native SSHFS
Wants=network-online.target
After=network-online.target

[Mount]
What={{ notes_owner_user }}@10.0.2.2:/vault
Where={{ notes_guest_root }}
Type=fuse.sshfs
Options=_netdev,nodev,nosuid,noexec,reconnect,allow_other,default_permissions,uid=61102,gid=61102,dir_cache=no,IdentityFile=/etc/zelab-notes/owner.key,IdentitiesOnly=yes,BatchMode=yes,StrictHostKeyChecking=yes,UserKnownHostsFile=/etc/zelab-notes/known_hosts,port={{ notes_sftp_port }},ConnectTimeout=10,ServerAliveInterval=15,ServerAliveCountMax=3
TimeoutSec=45

[Install]
WantedBy=multi-user.target
